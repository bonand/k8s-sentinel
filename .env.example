# path: .env.example
# path: .env.example

# --- Active Graph runtime ---
ACTIVEGRAPH_RUN_ID=k8s-sentinel-dev
# Store usato dall'AGENT (scrittura)
ACTIVEGRAPH_PERSIST_TO=sqlite:///data/sentinel.db
# Store usato dalla DASHBOARD (sola lettura); di norma coincide col precedente
ACTIVEGRAPH_STORE_URL=sqlite:///data/sentinel.db
# URL pubblico della dashboard, per i link "inspect trace" negli alert Slack
ACTIVEGRAPH_INSPECT_URL=http://localhost:8000

# --- LLM provider ---
ANTHROPIC_API_KEY=
SENTINEL_LLM_MODEL=claude-sonnet-4-5

# --- Ingestion HTTP ---
INGESTION_HOST=0.0.0.0
INGESTION_PORT=9000

# --- Notifiche ---
SLACK_WEBHOOK_URL=
PAGERDUTY_INTEGRATION_KEY=

# --- Loki (log applicativi) ---
LOKI_URL=
LOKI_TOKEN=

# --- Esecuzione remediation (safety) ---
K8S_SENTINEL_EXECUTION_ENABLED=false
K8S_SENTINEL_ALLOWED_NAMESPACES=staging
